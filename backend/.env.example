# SAMPLE_PASSWORD=choose_a_sample_password

RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret
# Optional: only for a webhook on a public https address
# RAZORPAY_WEBHOOK_SECRET=a_long_random_text